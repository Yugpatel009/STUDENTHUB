# ==============================================================================
# STUDENT HUB - ENVIRONMENT CONFIGURATION TEMPLATE
# Charotar University of Science and Technology (CHARUSAT)
# Subject: Web Development Frameworks (ITUE203) - Practical 15
# ==============================================================================

# Application Environment (development | production)
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/STUDENTHUB

# Database Credentials (MySQL / MariaDB via XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=student_hub
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Session Security & Inactivity Timeout (in seconds: 1800 = 30 minutes)
SESSION_TIMEOUT=1800
REMEMBER_ME_DAYS=30

# Upload Configurations
UPLOAD_MAX_FILESIZE_MB=2
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Administrative Notification
ADMIN_EMAIL=admin@charusat.edu.in
